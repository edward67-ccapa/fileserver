<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If the request is already for public, do not rewrite again
    RewriteCond %{REQUEST_URI} !^/fileserver/public/
    RewriteRule ^$ public/ [L]

    RewriteCond %{REQUEST_URI} !^/fileserver/public/
    RewriteRule (.*) public/$1 [L]
</IfModule>
